# Copy this file to .env and fill in real values. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=campus_marketplace
FLASK_DEBUG=1

# Set to 1 when deployed on HTTPS
SESSION_COOKIE_SECURE=0

# Optional: only allow these email domains to register (comma separated). Empty = any email.
# Example: ALLOWED_EMAIL_DOMAINS=muj.manipal.edu
ALLOWED_EMAIL_DOMAINS=

# Optional: 1 = visitors must log in before even browsing
REQUIRE_LOGIN_TO_BROWSE=0

# Optional: Cloudinary image hosting. If left empty, images are saved in static/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
